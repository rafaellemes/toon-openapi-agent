{
  "openapi": "3.0.0",
  "info": { "title": "Structural Fidelity API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/widgets": {
      "post": {
        "operationId": "createWidget",
        "summary": "Create widget",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/WidgetBody" },
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Widget" } } }
          }
        }
      }
    },
    "/contacts": {
      "post": {
        "operationId": "createContact",
        "summary": "Create contact",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contact" } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/nodes": {
      "post": {
        "operationId": "createNode",
        "summary": "Create node",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Node" } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "components": {
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "requestBodies": {
      "WidgetBody": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Widget" } } }
      }
    },
    "schemas": {
      "Base": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "maxLength": 50 }
        }
      },
      "Widget": {
        "type": "object",
        "required": ["name"],
        "allOf": [
          { "$ref": "#/components/schemas/Base" },
          {
            "type": "object",
            "properties": {
              "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
              "meta": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/Tag" } },
              "freeform": { "type": "object", "additionalProperties": true },
              "closed": { "type": "object", "additionalProperties": false },
              "kind": { "type": "string", "enum": ["a", "b", "c"] },
              "forbidden": { "not": { "type": "string" } }
            }
          }
        ]
      },
      "Tag": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        }
      },
      "Contact": {
        "oneOf": [
          { "type": "object", "properties": { "email": { "type": "string", "format": "email" } } },
          { "type": "object", "properties": { "phone": { "type": "string" } } }
        ]
      },
      "Node": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "child": { "$ref": "#/components/schemas/Node" }
        }
      }
    }
  }
}
